# ── Admin ───────────────────────────────────────────────
ADMIN_PIN=4826
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Firebase (Firestore database) ──────────────────────
# Paste the whole service-account JSON on ONE line:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}

# ── Push notifications (run: npm run vapid) ────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
